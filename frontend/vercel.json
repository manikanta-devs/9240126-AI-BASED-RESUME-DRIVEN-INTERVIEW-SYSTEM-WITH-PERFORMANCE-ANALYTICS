{
  "version": 2,
  "name": "ai-interview-system",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://mca-final-project.onrender.com/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://mca-final-project.onrender.com/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

